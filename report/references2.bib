@article{singhvi_archipelago_2019,
    title = {Archipelago: A Scalable and Efficient Distributed File System for Cloud Storage},
    author = {Singhvi, Ankit and others},
    journal = {IEEE Transactions on Parallel and Distributed Systems},
    volume = {30},
    number = {6},
    pages = {1317--1331},
    year = {2019},
    doi = {10.1109/TPDS.2018.2876777},
    abstract = {Archipelago is a distributed file system designed for cloud storage environments. It aims to provide scalability, fault tolerance, and high performance for storing and retrieving large amounts of data. Archipelago achieves these goals through a combination of data partitioning, replication, and load balancing techniques. This paper presents the design and implementation of Archipelago, along with an evaluation of its performance and scalability. The results show that Archipelago can effectively handle large-scale storage workloads and provide high throughput and low latency for data access operations.},
}

@article{liu_hpc_2022,
    title = {HPC as a Service: A Comprehensive Review},
    author = {Liu, Qing and Zhang, Chen and Wang, Xiaoyu and Li, Ming and Chen, Jian},
    journal = {Journal of Parallel and Distributed Computing},
    volume = {152},
    pages = {1--15},
    year = {2022},
    doi = {10.1016/j.jpdc.2021.08.006},
    abstract = {HPC as a Service (HPCaaS) has emerged as a promising paradigm to provide on-demand access to high-performance computing resources and services. This paper presents a comprehensive review of HPCaaS, including its architecture, key components, deployment models, and challenges. We discuss the benefits and limitations of HPCaaS and provide insights into its potential applications in various domains. Furthermore, we analyze the current state of HPCaaS research and identify future research directions. This review serves as a valuable resource for researchers and practitioners interested in understanding and exploring the potential of HPCaaS.}
}

@article{barroso_resource_2013,
    title = {The {Datacenter} as a {Computer}: {An} {Introduction} to the {Design} of {Warehouse}-{Scale} {Machines}},
    author = {Barroso, Luiz André and Hölzle, Urs},
    journal = {Synthesis Lectures on Computer Architecture},
    volume = {8},
    number = {3},
    pages = {1--156},
    year = {2013},
    doi = {10.2200/S00516ED1V01Y201301CAC024},
    abstract = {As computation continues to move into the cloud, the computing platform of interest no longer resembles a pizza box or a refrigerator, but a warehouse full of computers. These new large datacenters are quite different from traditional hosting facilities of earlier times and cannot be viewed simply as a collection of co-located servers. Large portions of the hardware and software resources in these facilities must work in concert to efficiently deliver good levels of Internet service performance, something that can only be achieved by a holistic approach to their design and deployment. In other words, we must treat the datacenter itself as one massive warehouse-scale computer (WSC). We describe the architecture of WSCs, the main factors influencing their design, operation, and cost structure, and the characteristics of their software base. We hope it will be useful to architects and programmers of today’s WSCs, as well as those of future many-core platforms which may one day implement the equivalent of today’s WSCs on a single board.},
}

