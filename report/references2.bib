@inproceedings{kumar_containerized_2022,
	title = {Containerized {MPI} Application on {InfiniBand} based {HPC}: An Empirical Study},
	url = {https://ieeexplore.ieee.org/abstract/document/9824366},
	doi = {10.1109/INCET54531.2022.9824366},
	shorttitle = {Containerized {MPI} Application on {InfiniBand} based {HPC}},
	abstract = {Nowadays, containerization techniques for High Performance Computing ({HPC}) are becoming more prominent with the increase in the features and complexity of scientific applications. Message Passing Interface ({MPI}) applications have many dependencies in terms of other scientific libraries, new patches, new code versions, and bug fixes to effectively execute scientific workloads. The tasks of updating the version of the code, installing new patches, and troubleshooting build issues are very time-consuming and complicated. These problems are tackled by making {MPI} applications portable through the use of the containerization concept, which hides system-level dependencies and complexities. This work presents the challenges and approaches for building and executing containerized {MPI} applications on {InfiniBand} based {HPC}. The comprehensive performance evaluation of a containerized {MPI} application converted from Docker to Singularity is performed on {HPC} up to 880 {MPI} ranks using {InfiniBand} in reference to bare metal. In addition, profiling of {MPI} applications is done by running them in an isolated container environment on {InfiniBand} based {HPC} with 640 {MPI} ranks.},
	eventtitle = {2022 3rd International Conference for Emerging Technology ({INCET})},
	pages = {1--6},
	booktitle = {2022 3rd International Conference for Emerging Technology ({INCET})},
	author = {Kumar, Mandeep and Kaur, Gagandeep},
	urldate = {2024-04-05},
	date = {2022-05},
	keywords = {Codes, Computer bugs, Containerization, Containers, Docker, High Performance Computing, High performance computing, {InfiniBand}, Message Passing Interface, Message passing, Metals, Performance, Performance evaluation, Profiling, Singularity},
}

@inproceedings{sande_veiga_evaluation_2019,
	location = {Denver, {CO}, {USA}},
	title = {Evaluation and Benchmarking of Singularity {MPI} containers on {EU} Research e-Infrastructure},
	rights = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/{IEEE}.html},
	isbn = {978-1-72816-028-3},
	url = {https://ieeexplore.ieee.org/document/8950983/},
	doi = {10.1109/CANOPIE-HPC49598.2019.00006},
	abstract = {Linux Containers with the build-once run-anywhere principle have gained huge attention in the research community where portability and reproducibility are key concerns. Unlike virtual machines ({VMs}), containers run the underlying host {OS} kernel. The container ﬁlesystem can include all necessary nondefault prerequisites to run the container application at unaltered performance. For this reason, containers are popular in {HPC} for use with parallel/{MPI} applications. Some use cases include also abstraction layers, e.g. {MPI} applications require matching of {MPI} version between the host and the container, and/or {GPU} applications require the underlying {GPU} drivers to be installed within the container ﬁlesystem. In short, containers can only abstract what is above the {OS} kernel, not below. Consequently, portability is not completely granted.},
	eventtitle = {2019 {IEEE}/{ACM} International Workshop on Containers and New Orchestration Paradigms for Isolated Environments in {HPC} ({CANOPIE}-{HPC})},
	pages = {1--10},
	booktitle = {2019 {IEEE}/{ACM} International Workshop on Containers and New Orchestration Paradigms for Isolated Environments in {HPC} ({CANOPIE}-{HPC})},
	publisher = {{IEEE}},
	author = {Sande Veiga, {VIctor} and Simon, Manuel and Azab, Abdulrahman and Fernandez, Carlos and Muscianisi, Giuseppa and Fiameni, Giuseppe and Marocchi, Simone},
	urldate = {2024-04-05},
	date = {2019-11},
	langid = {english},
}

@inproceedings{sande_veiga_evaluation_2019-1,
	title = {Evaluation and Benchmarking of Singularity {MPI} containers on {EU} Research e-Infrastructure},
	url = {https://ieeexplore.ieee.org/abstract/document/8950983},
	doi = {10.1109/CANOPIE-HPC49598.2019.00006},
	abstract = {Linux Containers with the build-once run-anywhere principle have gained huge attention in the research community where portability and reproducibility are key concerns. Unlike virtual machines ({VMs}), containers run the underlying host {OS} kernel. The container filesystem can include all necessary non-default prerequisites to run the container application at unaltered performance. For this reason, containers are popular in {HPC} for use with parallel/{MPI} applications. Some use cases include also abstraction layers, e.g. {MPI} applications require matching of {MPI} version between the host and the container, and/or {GPU} applications require the underlying {GPU} drivers to be installed within the container filesystem. In short, containers can only abstract what is above the {OS} kernel, not below. Consequently, portability is not completely granted. This paper presents the experience of {PRACE} (Partnership for Advanced Computer in Europe) in supporting Singularity containers on {HPC} clusters and provides notes about possible approaches for deploying {MPI} applications using different use cases. Performance comparison between bare metal and container executions are also provided, showing a negligible overhead in the container execution.},
	eventtitle = {2019 {IEEE}/{ACM} International Workshop on Containers and New Orchestration Paradigms for Isolated Environments in {HPC} ({CANOPIE}-{HPC})},
	pages = {1--10},
	booktitle = {2019 {IEEE}/{ACM} International Workshop on Containers and New Orchestration Paradigms for Isolated Environments in {HPC} ({CANOPIE}-{HPC})},
	author = {Sande Veiga, {VÌctor} and Simon, Manuel and Azab, Abdulrahman and Fernandez, Carlos and Muscianisi, Giuseppa and Fiameni, Giuseppe and Marocchi, Simone},
	urldate = {2024-04-05},
